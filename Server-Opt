#!/bin/bash
# Customized Server Has Tailored by Marvin.W
# Copyright (c) 2026 By Marvin.W

set -euo pipefail

# Configurate Bash Environment:
cat >> /etc/bash.bashrc <<'EOF'

HISTSIZE=-1
HISTFILESIZE=-1
alias ll='ls -ahls --color=auto'
alias l='ls -ahls --color=auto'
alias sudo='sudo '
EOF

if grep -q '^HISTSIZE=' /etc/skel/.bashrc; then
    sed -i '/^HISTSIZE=/c\HISTSIZE=-1' /etc/skel/.bashrc
else
    echo 'HISTSIZE=-1' >> /etc/skel/.bashrc
fi

if grep -q '^HISTFILESIZE=' /etc/skel/.bashrc; then
    sed -i '/^HISTFILESIZE=/c\HISTFILESIZE=-1' /etc/skel/.bashrc
else
    echo 'HISTFILESIZE=-1' >> /etc/skel/.bashrc
fi

sed -i "s/#alias ll='ls -l'/alias ll='ls -ahls --color=auto'/" /etc/skel/.bashrc
sed -i "s/#alias l='ls -CF'/alias l='ls -ahls --color=auto'/" /etc/skel/.bashrc

# Vim and Vim.Tiny Configuration Customizing:
cat <<-EOF >> /etc/vim/vimrc.tiny
"
set nu ts=4 autoindent hlsearch incsearch showmode showcmd showmatch ignorecase smartcase hidden mouse=a paste nocompatible nobackup noswapfile cursorline ruler wrap linebreak laststatus=2
hi cursorLine cterm=bold ctermbg=DarkGray ctermfg=NONE
EOF

cat <<-EOF >> /etc/vim/vimrc
"
set nu ts=4 autoindent hlsearch incsearch showmode showcmd showmatch ignorecase smartcase hidden mouse=a paste nocompatible nobackup noswapfile cursorline ruler wrap linebreak laststatus=2
hi cursorLine cterm=bold ctermbg=DarkGray ctermfg=NONE
EOF

# Enable BBR as Algorithm of Flow Control:
echo "net.core.default_qdisc=fq" >> /etc/sysctl.conf
echo "net.ipv4.tcp_congestion_control=bbr" >> /etc/sysctl.conf
sysctl -p

# System Up to Date:
apt update
apt upgrade -y

# Enable ipv4 & ipv6 Forwarding
cat >> /etc/sysctl.conf <<EOF
net.ipv4.ip_forward = 1
net.ipv6.conf.all.forwarding = 1
EOF
sysctl -p /etc/sysctl.conf

# Login up a New User and Append to sudo Group:
read -rn1 -p 'New User (vugs) and Append to sudo Group? [y/N]: ' a
echo
[[ ${a:-N} == [Yy] ]] && useradd -m -s /bin/bash vugs && echo 'vugs:acdc7777' | chpasswd && usermod -aG sudo vugs && rm -rf -- /home/debian

# Inquiry the New Hostname:
read -rp "Input the new hostname of server: " hostname < /dev/tty && hostnamectl set-hostname "$hostname"

# Purge Obsoleted Packages, Temporary Files:
apt autoremove -y ; apt autoclean -y ; apt autopurge -y

rm -rf Server-Customize
history -c
reboot
